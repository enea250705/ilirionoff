# Authentication
# Generate a random secret: https://generate-secret.vercel.app/32 or `openssl rand -base64 32`
AUTH_SECRET=

# Database
# Create a POSTGRES_URL with neon.tech: https://neon.tech/docs/guides/vercel
POSTGRES_URL=postgresql://username:password@host:port/database_name
POSTGRES_URL_NON_POOLING=

# Vercel Blob
# Create a Vercel account and link it to your GitHub account
BLOB_READ_WRITE_TOKEN=

# API Keys for AI Models
DEEPSEEK_API_KEY=your_deepseek_api_key
XAI_API_KEY=your_xai_api_key
GROQ_API_KEY=your_groq_api_key

# Authentication 
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_random_secure_string

# Optional Database configuration
# DATABASE_URL=postgresql://user:password@host:port/database

# Optional: Weather API (for demo purposes only)
# WEATHER_API_KEY=your_weather_api_key
